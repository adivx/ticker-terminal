root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# Python backend follows the standard 4-space layout.
[*.py]
indent_size = 4

# Frontend (Vite / React) follows the ecosystem 2-space layout.
[*.{js,jsx,css,json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
